# Provider-Modus: 'demo' (Soforttest) oder 'apify' (Live Scraper)
PROVIDER_MODE=demo

# Apify Token als Platzhalter (Wird auf dem Server/Unraid befüllt)
APIFY_TOKEN=

# Pfade und Laufzeit-Einstellungen
DATABASE_PATH=/app/data/cars.db
SEARCH_INTERVAL_HOURS=24
RUN_ON_START=true

# Optionale Benachrichtigungskanäle
DISCORD_WEBHOOK_URL=
NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=